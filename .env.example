# Backend. Absolute paths are the most reliable.
MLPHIL_URL_BUNDLE=../models/model_bundle
MLPHIL_EMAIL_MODEL_DIR=../models/email_security_model
# Optional: test results for "How it works". Default: <email model folder>/../email_reports
MLPHIL_EMAIL_REPORTS=../models/email_reports
# Only needed if the website calls the API from a different origin (VITE_API_BASE set).
ALLOWED_ORIGINS=http://localhost:5173
# Accounts database (SQLite). Default: <project>/data/mlphil.db
MLPHIL_DB_PATH=../data/mlphil.db
# Set to 1 when the site is served over HTTPS, so the login cookie is only sent encrypted.
MLPHIL_COOKIE_SECURE=0

# Frontend (frontend/.env). Leave unset: the site calls /api on its own origin.
# VITE_API_BASE=http://localhost:8000

# Docker: website port
WEB_PORT=5173
